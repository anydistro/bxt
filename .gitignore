*.o
*.so
*.a
*.lib
*.dll
*.exe
bin/
*.out

# Package files
*.pkg.tar.zst
*.pkg.tar.zst.sig

# Logs and temporary files
*.log
*.tmp
*.temp
*~
*.swp
*.swo

# Backup and experimental files
*_b
