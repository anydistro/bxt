!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# CMake (deprecated, kept for migration reference only)
CMakeLists.txt.user
CMakeCache.txt
cmake_install.cmake
CMakeFiles/

# XMake build system files
.xmake/
**/.xmake/
*.xmake

# Conan package manager
conan.lock
conangraph.log
graph_info.json
*.conaninfo.txt
*.conanmanifest.txt

